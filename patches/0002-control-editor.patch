From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klave7 <5594473+klave7@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:00:00 -0600
Subject: [PATCH] Control editor from the gear menu: split A B X Y, key labels, stick styles, button opacity
---
diff --git a/dm/games/settings.tsv b/dm/games/settings.tsv
index fff15694..4ee6c316 100644
--- a/dm/games/settings.tsv
+++ b/dm/games/settings.tsv
@@ -25,6 +25,7 @@ DM_FULLSCREEN	choice	0=Window,1=Fullscreen	0	platform:mac	Game	Display mode		lev
 DM_PICTURE_FIT	choice	fit=Fit,blur=Fit with blurred bars,image=Fit with still-image bars,fill=Fill,stretch=Stretch	blur	platform:ios	Game	Picture	Fill crops the game's 16:9 picture to cover the screen. Health bars, subtitles or maps near the edges can be cut off. A full-screen picture without cropping needs a patch for each game. Fit shows black bars where the screen has another shape; the blurred bars are a dimmed, blurred copy of the picture (a little more GPU time), the still-image bars a fixed dark pattern. Stretch fills the whole screen by changing the picture's shape: everything looks wider or taller than it is.
 DM_SHOW_FPS	toggle	-	build:DM_SHOW_FPS	platform:ios	Game	Frame-rate counter
 DM_TOUCH_HAPTICS	toggle	-	1	platform:ios	Controls	Touch feedback
+DM_PAD_EDIT	toggle	-	0	platform:ios	Controls	Edit controls at start	Opens the control editor once when the game starts. You can also choose Edit controls in the in-game menu (the gear) during play.
 DM_RUMBLE	toggle	-	1	always	Controls	Game rumble		level=basic
 DM_RUMBLE_GAIN	range	0:3:0.1	1.0	always	Controls	Rumble strength		needs=DM_RUMBLE=1
 DM_RUMBLE_MIN	range	0:0.9:0.05	0	always	Controls	Rumble cutoff
