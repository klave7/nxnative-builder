From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klave7 <5594473+klave7@users.noreply.github.com>
Date: Sun, 1 Nov 2026 12:00:00 -0600
Subject: [PATCH] In-game control editor, with floating and fixed stick styles
---
diff --git a/dm/games/settings.tsv b/dm/games/settings.tsv
index f188a156..b5f678b2 100644
--- a/dm/games/settings.tsv
+++ b/dm/games/settings.tsv
@@ -26,2 +26,5 @@ DM_BAR_FILL	choice	off=Black,blur=Blurred picture,image=Still image	blur	platfor
 DM_TOUCH_HAPTICS	toggle	-	1	platform:ios	Controls	Touch feedback
+DM_PAD_EDIT	toggle	-	0	platform:ios	Controls	Edit controls at start	Opens the control editor once when the game starts. You can also press and hold the layout button during play.
+DM_STICK_FLOAT_L	toggle	-	0	platform:ios	Controls	Floating left stick	The left stick appears where you put a finger down in the left third of the screen (on no button), instead of at a fixed place. Touches there no longer reach the game's own touch screen.
+DM_STICK_FIXED_R	toggle	-	0	platform:ios	Controls	Fixed right stick (3D layout)	Draws the right stick at a fixed place below the face buttons, like a Pro Controller's, instead of letting a touch in the right third be its centre.
 DM_RUMBLE	toggle	-	1	always	Controls	Game rumble		level=basic
diff --git a/dm/ios/Sources/DmGamepad.m b/dm/ios/Sources/DmGamepad.m
index 7be062a5..cdf92581 100644
--- a/dm/ios/Sources/DmGamepad.m
+++ b/dm/ios/Sources/DmGamepad.m
@@ -14,2 +14,5 @@
 //   Each physical controller is a player of its own (local co-op), as on the Mac: the first one connected is player 1, together with the touch gamepad, the next player 2, and so on up to 8; see "Physical controllers" below.
+//   Edit mode: press and hold the layout button (or turn on "Edit controls at start", DM_PAD_EDIT, on the settings screen) to drag each control where you want it and set its size (a slider);
+//     the positions are offsets from the built-in layout in u and the sizes factors, shared by the 2D and the 3D layout, kept in NSUserDefaults (DmPadCustom); not offered in the Tap layout.
+//     Each control can also be switched off (and the D-pad, L3 and R3 on in 2D): the choices are kept per layout (DmPadShown), the built-in ones where there is none. The editor draws a control that is off dimmed, so it can be picked and switched on again; the layout button is always there.
 //   Shaking the phone shakes the controller (DM_BTN_SHAKE: its six-axis sensor, hle_hid.c), whichever controls are in use; see "Shaking the phone" below.
@@ -32,2 +35,3 @@
 enum { B_A = 0, B_B, B_X, B_Y, B_LS, B_RS, B_L, B_R, B_ZL, B_ZR, B_PLUS, B_MINUS, B_LEFT, B_UP, B_RIGHT, B_DOWN, B_N };
+enum { E_FACE = 0, E_STICK, E_DPAD, E_ZL, E_L, E_ZR, E_R, E_L3, E_R3, E_MINUS, E_PLUS, E_N };   // the controls the player can move and resize (the diamond, the D-pad and the stick each as a whole)
 enum { C_NONE = 0, C_STICK, C_DPAD, C_FACE, C_BTN, C_SWAP, C_GAME };   // which control a touch holds; C_GAME: none, the touch goes to the game's touch screen (finger slot << 8)
@@ -128,2 +132,5 @@ static void phone_motion_start(UIView *body) {
 static const int k_btns[] = {B_ZL, B_L, B_ZR, B_R, B_MINUS, B_PLUS, B_LS, B_RS};   // keys locked at touch-down (L3 / R3 only in the 3D layout)
+static NSString *const k_custom_key = @"DmPadCustom";   // NSUserDefaults: E_N triples [dx, dy, size] (dx, dy in u from the built-in place, size a factor); absent = the built-in layout
+static NSString *const k_shown_key = @"DmPadShown";   // NSUserDefaults: for 2D and 3D, E_N numbers each: 0 = the layout's built-in choice, 1 = on, 2 = off
+static const CGFloat K_SIZE_MIN = 0.5, K_SIZE_MAX = 1.6;
 static NSString *const k_layout_key = @"DmPadLayout";   // NSUserDefaults: 0 = 2D, 1 = 3D, 2 = Tap (DM_GAME_PAD_LAYOUT's numbers)
@@ -132,3 +139,8 @@ static void phone_motion_start(UIView *body) {
 
-@interface DmGamepad : UIView
+// Stick styles (launcher settings, Controls): DM_STICK_FLOAT_L = the left stick floats (a touch landing on no control in the left third of the screen is its centre, as the right stick's in the right third);
+// DM_STICK_FIXED_R = the right stick (3D layout) is an ordinary fixed one, drawn below and inward of the diamond like a Pro Controller's, instead of the floating swipe area
+static BOOL stick_float_left(void) { const char *e = getenv("DM_STICK_FLOAT_L"); return e && atoi(e); }
+static BOOL stick_fixed_right(void) { const char *e = getenv("DM_STICK_FIXED_R"); return e && atoi(e); }
+
+@interface DmGamepad : UIView <UIGestureRecognizerDelegate>
 @end
