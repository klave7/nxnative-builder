From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: klave7 <5594473+klave7@users.noreply.github.com>
Date: Fri, 30 Oct 2026 12:00:00 -0600
Subject: [PATCH] Portrait mode for the iPhone Duo

Requires: 0001-blurred-bars, 0002-control-editor

---
diff --git a/dm/games/settings.py b/dm/games/settings.py
index d16b9cb9..fa824a8b 100644
--- a/dm/games/settings.py
+++ b/dm/games/settings.py
@@ -19,2 +19,3 @@ META = {
     'needs': r'DM_[A-Z0-9_]+=[^;=]+',        # <VAR>=<value>: a sub-setting, drawn only while the row that sets <VAR> has that value
+    'device': r'foldable',                   # a setting only that kind of device can use (the iPhone Duo): a front end that can tell shows it only there
 }
diff --git a/dm/games/settings.tsv b/dm/games/settings.tsv
index 96f1f175..920d8332 100644
--- a/dm/games/settings.tsv
+++ b/dm/games/settings.tsv
@@ -27,2 +27,3 @@ DM_TOUCH_HAPTICS	toggle	-	1	platform:ios	Controls	Touch feedback
 DM_PAD_EDIT	toggle	-	0	platform:ios	Controls	Edit controls at start	Opens the control editor once when the game starts. You can also press and hold the layout button during play.
+DM_PHONE_ROTATE	choice	auto=Automatic,0=0°,1=90°,2=180°,3=270°	auto	platform:ios	Controls	Gyro rotation	Automatic turns the motion controls for the iPhone Duo's inner screen and leaves other phones as they are. Choose a turn by hand if the pointer or aiming comes out turned.
 DM_RUMBLE	toggle	-	1	always	Controls	Game rumble		level=basic
@@ -30,2 +31,3 @@ DM_RUMBLE_GAIN	range	0:3:0.1	1.0	always	Controls	Rumble strength		needs=DM_RUMBL
 DM_RUMBLE_MIN	range	0:0.9:0.05	0	always	Controls	Rumble cutoff
+DM_PORTRAIT_LAYOUT	toggle	-	1	platform:ios	Controls	iPhone Duo portrait: game above the controls	Only for the iPhone Duo's inner screen held upright: the game on top, the controls below. Other phones and iPads stay landscape, whatever this says.	device=foldable
 DM_PRESENT_SNAP	toggle	-	DM_GAME_PRESENT_SNAP	gfxapi:nvn	Performance	Frame buffering	Up to one frame more display latency.
diff --git a/dm/gfx/nvn/nvn_mtl.m b/dm/gfx/nvn/nvn_mtl.m
index f841da34..a6263243 100644
--- a/dm/gfx/nvn/nvn_mtl.m
+++ b/dm/gfx/nvn/nvn_mtl.m
@@ -459,3 +459,3 @@ void mtl_init(void) {
     for (int i = 0; i < 3; i++) {
-        g_present_uv[i] = [g_dev newBufferWithLength:sizeof(float) * 16 options:MTLResourceStorageModeShared];   // 8 floats for the picture's crop, 8 for the bars' image (present_encode_m4)
+        g_present_uv[i] = [g_dev newBufferWithLength:sizeof(float) * 24 options:MTLResourceStorageModeShared];   // 8 floats for the picture's crop, 8 for the bars' image, 8 for the controls' image (present_encode_m4)
         if (!g_present_uv[i]) MDIE("failed to create present UV buffer[%d]", i);
@@ -11147,3 +11147,18 @@ static void present_pipeline(MTLPixelFormat format) {
 // full-screen setup, e.g. 1952x900 against 2868x1320 differs by 0.17 %) the whole canvas, leaving no border of a few pixels
+// The portrait layout (front_ios.m: a screen taller than wide, the iPhone Duo's inner screen held upright): the canvas is split at g_split_y of its height from the top. The picture is centred in the top part
+// (below g_split_top of the height, the camera's area), with the bars' fill around it; the lower part shows the controls' image (mtl_set_controls_image) behind the on-screen controls. Fractions of the
+// canvas, so the screen's scale does not matter. g_split_y < 0: no split
+static _Atomic double g_split_top = -1, g_split_y = -1;
+void mtl_set_present_split(double top, double split) { atomic_store_explicit(&g_split_top, top, memory_order_relaxed); atomic_store_explicit(&g_split_y, split, memory_order_relaxed); }
+static int present_split(double dw, double dh, double *top, double *y) {
+    double t = atomic_load_explicit(&g_split_top, memory_order_relaxed), s = atomic_load_explicit(&g_split_y, memory_order_relaxed);
+    if (!(s > 0 && s < 1 && dh > dw)) return 0;
+    *top = t > 0 && t < s ? t * dh : 0; *y = s * dh; return 1;
+}
 static MTLViewport present_viewport(double cw, double ch, double dw, double dh) {
+    double st, sy;
+    if (present_split(dw, dh, &st, &sy)) {   // centred in the top part, under the camera's area
+        double rh = sy - st, s = fmin(dw / cw, rh / ch);
+        return (MTLViewport){floor((dw - cw * s) / 2), st + floor((rh - ch * s) / 2), round(cw * s), round(ch * s), 0, 1};
+    }
     double s = fmin(dw / cw, dh / ch);
@@ -11276,11 +11291,11 @@ static int bar_mode(void) {   // 0 black, 1 blurred picture, 2 still image
 }
-static CGImageRef g_bar_cg;                    // the image the front end handed over (retained)
-static __strong id<MTLTexture> g_bar_img;      // its texture, made on the present thread at the first present that needs it (the device may not exist when the front end calls)
-static _Atomic double g_bar_img_aspect;
+static CGImageRef g_bar_cg, g_ctl_cg;          // the images the front end handed over (retained): the bars' (bar_background.jpg) and the controls' (controls_background.jpg)
+static __strong id<MTLTexture> g_bar_img, g_ctl_img;   // their textures, made on the present thread at the first present that needs them (the device may not exist when the front end calls)
+static _Atomic double g_bar_img_aspect, g_ctl_img_aspect;
 void mtl_set_bar_image(CGImageRef img) { if (img) { CGImageRetain(img); g_bar_cg = img; } }
-static id<MTLTexture> bar_image(void) {
-    if (g_bar_img || !g_bar_cg) return g_bar_img;
-    size_t w = CGImageGetWidth(g_bar_cg), h = CGImageGetHeight(g_bar_cg);
-    CGImageRef cg = g_bar_cg; g_bar_cg = NULL;   // one try
-    if (!w || !h || w > 8192 || h > 8192) { MLOG("[RED] present bars: the image is %zux%zu, not used", w, h); CGImageRelease(cg); return nil; }
+void mtl_set_controls_image(CGImageRef img) { if (img) { CGImageRetain(img); g_ctl_cg = img; } }
+static id<MTLTexture> cg_texture(CGImageRef *cgp, const char *what, _Atomic double *aspect) {   // one try; the CGImage is released
+    CGImageRef cg = *cgp; *cgp = NULL; if (!cg) return nil;
+    size_t w = CGImageGetWidth(cg), h = CGImageGetHeight(cg);
+    if (!w || !h || w > 8192 || h > 8192) { MLOG("[RED] present: the %s image is %zux%zu, not used", what, w, h); CGImageRelease(cg); return nil; }
     uint8_t *px = calloc(w * h, 4); CGColorSpaceRef cs = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
@@ -11291,7 +11306,14 @@ static int bar_mode(void) {   // 0 black, 1 blurred picture, 2 still image
     id<MTLTexture> t = cx ? [g_dev newTextureWithDescriptor:d] : nil;
-    if (t) { [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4]; t.label = @"present bars image"; res_add(t); res_commit(); g_bar_img = t; atomic_store(&g_bar_img_aspect, (double)w / h);
-        MLOG("present bars: the still image is %zux%zu", w, h); }
-    else MLOG("[RED] present bars: cannot make a texture of the image (%zux%zu)", w, h);
+    if (t) { [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:px bytesPerRow:w * 4]; t.label = @(what); res_add(t); res_commit(); atomic_store(aspect, (double)w / h);
+        MLOG("present: the %s image is %zux%zu", what, w, h); }
+    else MLOG("[RED] present: cannot make a texture of the %s image (%zux%zu)", what, w, h);
     if (cx) CGContextRelease(cx); if (cs) CGColorSpaceRelease(cs); free(px); CGImageRelease(cg);
-    return g_bar_img;
+    return t;
+}
+static id<MTLTexture> bar_image(void) { if (!g_bar_img && g_bar_cg) g_bar_img = cg_texture(&g_bar_cg, "present bars", &g_bar_img_aspect); return g_bar_img; }
+static id<MTLTexture> ctl_image(void) { if (!g_ctl_img && g_ctl_cg) g_ctl_img = cg_texture(&g_ctl_cg, "present controls", &g_ctl_img_aspect); return g_ctl_img; }
+// The constants (crop rectangle of the quad) that make an image of shape ia cover a region of shape ca, cropped from its middle
+static void cover_uv(float *k, double ia, double ca) {
+    double w2 = ca > ia ? 1 : ca / ia, h2 = ca > ia ? ia / ca : 1;
+    k[0] = (float)((1 - w2) / 2); k[1] = (float)((1 - h2) / 2); k[2] = (float)w2; k[3] = (float)h2; k[4] = 0; k[5] = 0; k[6] = 1; k[7] = 1;
 }
@@ -11334,5 +11356,6 @@ static int present_encode_m4(id<MTL4CommandBuffer> cb, id<MTLTexture> src, id<MT
     present_pipeline(dst.pixelFormat);
-    double dw = dst.width, dh = dst.height;
+    double dw = dst.width, dh = dst.height, st = 0, sy = 0;
+    int split = present_split(dw, dh, &st, &sy);   // the portrait layout: the picture centred in the top part, the controls' image in the lower part
     MTLViewport vp = present_viewport(r[2], r[3], dw, dh);
-    int full = vp.originX == 0 && vp.originY == 0 && vp.width == dw && vp.height == dh;
+    int full = !split && vp.originX == 0 && vp.originY == 0 && vp.width == dw && vp.height == dh;
     if (r[2] && r[3]) atomic_store_explicit(&g_present_aspect, (double)r[2] / (double)r[3], memory_order_relaxed);
@@ -11340,4 +11363,6 @@ static int present_encode_m4(id<MTL4CommandBuffer> cb, id<MTLTexture> src, id<MT
     if (up) { tex = up; r[0] = r[1] = 0; r[2] = up.width; r[3] = up.height; }   // the scaled picture, the viewport's size: drawn 1:1
-    int mode = !full && fx == &g_fx_present ? bar_mode() : 0;   // not in a screenshot's present
-    id<MTLTexture> bg = nil, img = mode == 2 ? bar_image() : nil;
+    int live = fx == &g_fx_present;   // not a screenshot's present: its bars and lower part stay black
+    int mode = !full && live ? bar_mode() : 0;
+    double bw = dw, bh = split ? sy : dh;   // the bars' region: the whole canvas, or the top part
+    id<MTLTexture> bg = nil, img = mode == 2 ? bar_image() : nil, cimg = split && live ? ctl_image() : nil;
     float *uv = uvb.contents; NSUInteger tw = tex.width, th = tex.height, cx = r[0], cy = r[1], cw = r[2], ch = r[3];
@@ -11346,10 +11371,8 @@ static int present_encode_m4(id<MTL4CommandBuffer> cb, id<MTLTexture> src, id<MT
     if (atomic_load_explicit(&g_origin_ll, memory_order_relaxed)) { uv[1] += uv[3]; uv[3] = -uv[3]; }   // lower-left origin: the window image is stored bottom-up
-    if (mode == 1) bg = bar_blur_m4(cb, tex, uvb, dst.pixelFormat, dw, dh);
-    if (img) {   // the image covers the canvas, cropped from its middle (constants in the buffer's second half)
-        double ia = atomic_load(&g_bar_img_aspect), ca = dw / dh, w2 = ca > ia ? 1 : ca / ia, h2 = ca > ia ? ia / ca : 1;
-        uv[8] = (float)((1 - w2) / 2); uv[9] = (float)((1 - h2) / 2); uv[10] = (float)w2; uv[11] = (float)h2; uv[12] = 0; uv[13] = 0; uv[14] = 1; uv[15] = 1;
-    }
+    if (mode == 1) bg = bar_blur_m4(cb, tex, uvb, dst.pixelFormat, bw, bh);
+    if (img) cover_uv(uv + 8, atomic_load(&g_bar_img_aspect), bw / bh);                  // the bars' image covers the bars' region (constants in the buffer's second part)
+    if (cimg) cover_uv(uv + 16, atomic_load(&g_ctl_img_aspect), dw / (dh - sy));         // the controls' image covers the lower part (third part)
     MTL4RenderPassDescriptor *rp = [MTL4RenderPassDescriptor new];
     rp.colorAttachments[0].texture = dst;
-    rp.colorAttachments[0].loadAction = full || bg || img ? MTLLoadActionDontCare : MTLLoadActionClear;   // the bars' fill draws every pixel
+    rp.colorAttachments[0].loadAction = full || (!split && (bg || img)) ? MTLLoadActionDontCare : MTLLoadActionClear;   // the bars' fill draws every pixel (with a split, the camera's area stays as cleared)
     rp.colorAttachments[0].storeAction = MTLStoreActionStore;
@@ -11363,9 +11386,14 @@ static int present_encode_m4(id<MTL4CommandBuffer> cb, id<MTLTexture> src, id<MT
     [g_present_args setAddress:uvb.gpuAddress atIndex:0];
-    if (bg || img) {   // the dimmed, blurred picture or the still image over the whole canvas, the sharp picture on top of it
+    if (bg || img) {   // the dimmed, blurred picture or the still image over the bars' region, the sharp picture on top of it
         if (bg) [g_present_args setTexture:bg.gpuResourceID atIndex:0];
         else { [g_present_args setTexture:img.gpuResourceID atIndex:0]; [g_present_args setAddress:uvb.gpuAddress + 8 * sizeof(float) atIndex:0]; }
-        [en setViewport:(MTLViewport){0, 0, dw, dh, 0, 1}]; [en setRenderPipelineState:bg ? g_bar_dim_pso : g_blit_pso];
+        [en setViewport:(MTLViewport){0, 0, bw, bh, 0, 1}]; [en setRenderPipelineState:bg ? g_bar_dim_pso : g_blit_pso];
+        [en drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    }
+    if (cimg) {   // the lower part: the controls' image
+        [g_present_args setTexture:cimg.gpuResourceID atIndex:0]; [g_present_args setAddress:uvb.gpuAddress + 16 * sizeof(float) atIndex:0];
+        [en setViewport:(MTLViewport){0, sy, dw, dh - sy, 0, 1}]; [en setRenderPipelineState:g_blit_pso];
         [en drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
-        [g_present_args setTexture:tex.gpuResourceID atIndex:0]; [g_present_args setAddress:uvb.gpuAddress atIndex:0];
     }
+    if (bg || img || cimg) { [g_present_args setTexture:tex.gpuResourceID atIndex:0]; [g_present_args setAddress:uvb.gpuAddress atIndex:0]; }
     [en setViewport:vp]; [en setRenderPipelineState:g_blit_pso];
@@ -11379,3 +11407,3 @@ static int present_offscreen_m4(id<MTLTexture> src, const int crop[4], id<MTLTex
     id<MTL4CommandAllocator> al = [g_dev newCommandAllocator]; id<MTL4CommandBuffer> cb = [g_dev newCommandBuffer];
-    id<MTLBuffer> uvb = [g_dev newBufferWithLength:sizeof(float) * 16 options:MTLResourceStorageModeShared];
+    id<MTLBuffer> uvb = [g_dev newBufferWithLength:sizeof(float) * 24 options:MTLResourceStorageModeShared];
     if (!al || !cb || !uvb) { MLOG("[RED] offscreen present: no command allocator or buffer"); return 0; }
diff --git a/dm/ios/Sources/DmGamepad.m b/dm/ios/Sources/DmGamepad.m
index 5ae75b2a..e72cb918 100644
--- a/dm/ios/Sources/DmGamepad.m
+++ b/dm/ios/Sources/DmGamepad.m
@@ -10,3 +10,3 @@
 //     then in 3D the right stick for a touch in the right third.
-//   Everything hugs the edges and corners to leave the picture room; controls sit over the picture, one CAShapeLayer each: a press only swaps the fill, a stick only moves its knob, nothing redraws the whole screen.
+//   Everything hugs the edges and corners to leave the picture room (the left and right margins are the same on both sides: the smaller of the two safe-area insets); controls sit over the picture, one CAShapeLayer each: a press only swaps the fill, a stick only moves its knob, nothing redraws the whole screen.
 //   Touches no control takes (in 3D, those outside the right third) go to the game's touch screen (pushGame; Super Mario Galaxy's pointer in handheld mode).
@@ -89,2 +89,4 @@ static void motion_start(void) {
 static _Atomic int g_iface_orient = 3;      // UIInterfaceOrientation, updated on layout
+static _Atomic int g_phone_rotate = -1;     // DM_PHONE_ROTATE: quarter turns more about the screen's normal (the settings screen's Gyro rotation); -1 = automatic
+static _Atomic int g_auto_quarter;          // the automatic choice: 1 on a known foldable's inner screen while its window is landscape, else 0 (updated on every layout)
 static BOOL g_motion_body;                  // samples in the body's frame (iOS 27+)
@@ -100,2 +102,3 @@ static void phone_motion_start(UIView *body) {
     NSOperationQueue *q = [NSOperationQueue new]; q.maxConcurrentOperationCount = 1;
+    // DM_PHONE_ROTATE=<0..3> turns the sensors that many more quarter turns about the screen's normal, for a screen that sits turned against the body (a foldable's)
     [g_motion startDeviceMotionUpdatesToQueue:q withHandler:^(CMDeviceMotion *d, NSError *err) {
@@ -106,2 +109,4 @@ static void phone_motion_start(UIView *body) {
         motion_phone_to_switch(o, a, as); motion_phone_to_switch(o, w, ws);
+        int quarter = atomic_load(&g_phone_rotate); if (quarter < 0) quarter = atomic_load(&g_auto_quarter);
+        for (int k = 0; k < quarter; k++) { float t = as[0]; as[0] = -as[1]; as[1] = t; t = ws[0]; ws[0] = -ws[1]; ws[1] = t; }   // a quarter turn about z: (x, y) → (−y, x)
         dm_motion_set_switch(0, as, ws);
@@ -138,2 +143,5 @@ static void phone_motion_start(UIView *body) {
 double mtl_present_aspect(void);   // nvn_mtl.m: width / height of the picture the last present showed
+// A known foldable's inner screen by the shape of its native size in pixels (either way round): the iPhone Duo's, 0.7035 wide to tall (2007 x 2853 at scale 3.0 in a landscape window, 1878 x 2670 at
+// scale 2.8 in a portrait one: the size changes, the shape does not; the closed screen's is 0.687, an iPad's 0.69 to 0.75). The gyro rule and the portrait layout are for it
+BOOL dm_foldable_inner_screen(CGSize px) { CGFloat lo = fmin(px.width, px.height), hi = fmax(px.width, px.height); return lo >= 1700 && fabs(lo / hi - 0.7035) < 0.0021; }
 
@@ -163,3 +171,3 @@ @implementation DmGamepad {
     UITouch *_editTouch; CGPoint _editLast;        // the finger dragging the selected control
-    UIView *_panel; UILabel *_selLabel; UISlider *_slider; UISwitch *_showSwitch;
+    UIView *_panel; UILabel *_selLabel; UISlider *_slider; UISwitch *_showSwitch; UIStackView *_mainStack;   // the panel: the control's settings
     signed char _vis[2][E_N];                      // per layout (2D, 3D): 0 = built-in choice, 1 = the player turned the control on, 2 = off
@@ -221,2 +229,5 @@ - (instancetype)initWithFrame:(CGRect)f {
         [self padsChanged:nil];
+        const char *pr = getenv("DM_PHONE_ROTATE"); int quarter = !pr || !*pr || !strcmp(pr, "auto") ? -1 : ((atoi(pr) % 4) + 4) % 4;
+        atomic_store(&g_phone_rotate, quarter);
+        if (quarter >= 0) LOG("front end: the phone's gyro is turned %d quarter turn(s) more (DM_PHONE_ROTATE)", quarter);
         motion_start();
@@ -247,5 +258,23 @@ - (void)nextLayout {   // 2D → 3D (→ Tap in handheld mode) → 2D: release e
 // ---- Layout (points; computed inside the safe area) ----
-- (CGRect)safe { return UIEdgeInsetsInsetRect(self.bounds, self.safeAreaInsets); }
-- (CGRect)corner { UIEdgeInsets i = self.safeAreaInsets; i.left *= K_CORNER_IN; i.right *= K_CORNER_IN; return UIEdgeInsetsInsetRect(self.bounds, i); }   // the rectangle the bottom-corner controls use
-- (CGFloat)u { return MIN(self.bounds.size.height / 430.0, 1.3); }   // 1 = 430 points tall (iPhone Pro Max landscape)
+// Portrait (a screen taller than wide, such as the iPhone Duo's inner screen held upright; DM_PORTRAIT_LAYOUT, on by default): the screen is split in half. The picture is centred in the top half (the present
+// does the same, nvn_mtl.m present_viewport, with the bars' fill around it), and the controls take the bottom half, over the image the present shows there. Every control is placed in a rectangle (ctl): the
+// whole screen in landscape, the bottom half in portrait, so the same places work in both
+static BOOL portrait_layout(void) { const char *e = getenv("DM_PORTRAIT_LAYOUT"); return !e || atoi(e); }
+- (BOOL)portrait { CGSize s = self.bounds.size; return s.height > s.width && portrait_layout(); }
+- (CGFloat)pictureTop { return self.safeAreaInsets.top; }   // the picture starts below the camera / status area
+- (CGRect)pictureRect {   // where the picture is shown, in points: as the present fits it to the shape the game draws (portrait: centred in the top half; else centred in the whole screen)
+    CGRect b = self.bounds; double pa = 16.0 / 9.0;
+    { const char *m = getenv("DM_BAR_FILL"); if (m && (!strcmp(m, "blur") || !strcmp(m, "image")) && mtl_present_aspect() > 0) pa = mtl_present_aspect(); }   // the bars filled: the view is the whole screen and the picture is fitted in it as the present did
+    if (self.portrait) {
+        CGFloat top = self.pictureTop, rh = MAX(b.size.height / 2 - top, 1), w = MIN(b.size.width, rh * pa), h = w / pa;
+        return CGRectMake((b.size.width - w) / 2, top + (rh - h) / 2, w, h);
+    }
+    CGFloat w = b.size.width, h = b.size.height; if (w / h > pa) w = h * pa; else h = w / pa;
+    return CGRectMake((b.size.width - w) / 2, (b.size.height - h) / 2, w, h);
+}
+- (CGRect)ctl { CGRect b = self.bounds; return self.portrait ? CGRectMake(0, b.size.height / 2, b.size.width, b.size.height / 2) : b; }
+- (UIEdgeInsets)padInsets { UIEdgeInsets i = self.safeAreaInsets; i.left = i.right = MIN(i.left, i.right); if (self.portrait) i.top = 0; return i; }   // the sides match: the camera's side no longer pushes its controls in, both sides take the smaller inset (none where one side is clear)
+- (CGRect)safe { return UIEdgeInsetsInsetRect(self.ctl, self.padInsets); }
+- (CGRect)corner { UIEdgeInsets i = self.padInsets; i.left *= K_CORNER_IN; i.right *= K_CORNER_IN; return UIEdgeInsetsInsetRect(self.ctl, i); }   // the rectangle the bottom-corner controls use
+- (CGFloat)u { CGRect c = self.ctl; CGFloat u = MIN(c.size.height / 430.0, 1.3); return self.portrait ? MIN(u, c.size.width / 690.0) : u; }   // 1 = 430 points tall (iPhone Pro Max landscape); in portrait also at most the width's worth
 static CGPoint side(CGRect s, int right, CGFloat dx, CGFloat y) { return CGPointMake(right ? CGRectGetMaxX(s) - dx : CGRectGetMinX(s) + dx, y); }
@@ -269,3 +298,3 @@ - (CGPoint)stickCentre:(int)i { return i ? _rCentre : self.stickHome; }
 - (CGFloat)stickR:(int)i { return i ? K_RSTICK_R * self.u : K_STICK_R * self.u * [self sc:E_STICK]; }
-- (BOOL)inRightArea:(CGPoint)p { CGRect b = self.bounds; return p.x >= CGRectGetMaxX(b) - b.size.width * K_RSWIPE; }
+- (BOOL)inRightArea:(CGPoint)p { CGRect b = self.bounds; return p.x >= CGRectGetMaxX(b) - b.size.width * K_RSWIPE && (!self.portrait || p.y >= CGRectGetMinY(self.ctl)); }   // portrait: only below the picture, so a touch on the picture stays the game's
 - (CGPoint)dpadCenter { CGRect s = self.corner; CGFloat u = self.u; return add(side(s, 0, K_LOW_X * u, CGRectGetMaxY(s) - K_LOW_Y * u), [self off:E_DPAD]); }
@@ -352,7 +381,4 @@ - (void)recompute {
 - (void)pushGame {
-    CGRect b = self.bounds; CGFloat w = b.size.width, h = b.size.height;
+    CGRect pr = self.pictureRect; CGFloat w = pr.size.width, h = pr.size.height, x0 = pr.origin.x, y0 = pr.origin.y;
